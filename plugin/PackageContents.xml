<?xml version="1.0" encoding="utf-8"?>
<!--
  Multi-release bundle. AutoCAD picks the ComponentEntry whose RuntimeRequirements
  match the running release, so one bundle serves Civil 3D 2025 (R25.0, .NET 8),
  2026 (R25.1, .NET 8) and 2027 (R26.0, .NET 10) side by side.
  install.ps1 regenerates this file listing only the releases it actually built.
-->
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="AutoCAD"
                    ProductType="Application"
                    Name="Civil3DMcpBridge"
                    Description="Bridges Claude (MCP) to Civil 3D over local HTTP"
                    AppVersion="0.4.0"
                    Author="AfroBIM Studios (Venture Kubariho)"
                    ProductCode="{C3DA0000-0000-0000-0000-000000000001}"
                    UpgradeCode="{C3DA0000-0000-0000-0000-000000000002}">
  <CompanyDetails Name="AfroBIM Studios" Url="https://afrobim.com" />

  <Components Description="Civil 3D 2025">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" SeriesMax="R25.0" />
    <ComponentEntry AppName="Civil3DMcpBridge" ModuleName="./Contents/2025/Civil3DMcpBridge.dll"
                    AppDescription="MCP bridge for Civil 3D 2025" LoadOnAutoCADStartup="True" LoadOnCommandInvocation="False" />
  </Components>

  <Components Description="Civil 3D 2026">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.1" SeriesMax="R25.1" />
    <ComponentEntry AppName="Civil3DMcpBridge" ModuleName="./Contents/2026/Civil3DMcpBridge.dll"
                    AppDescription="MCP bridge for Civil 3D 2026" LoadOnAutoCADStartup="True" LoadOnCommandInvocation="False" />
  </Components>

  <Components Description="Civil 3D 2027">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R26.0" SeriesMax="R26.0" />
    <ComponentEntry AppName="Civil3DMcpBridge" ModuleName="./Contents/2027/Civil3DMcpBridge.dll"
                    AppDescription="MCP bridge for Civil 3D 2027" LoadOnAutoCADStartup="True" LoadOnCommandInvocation="False" />
  </Components>
</ApplicationPackage>
